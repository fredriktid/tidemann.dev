---
import { projects } from '@/content/projects';
import { site } from '@/content/site';
import Arrow from './Arrow.astro';

const featured = projects.filter((p) => p.featured);
const rest = projects.filter((p) => !p.featured);

// Client / Project / Notes columns, shared by the header and every row.
const columns = 'lg:grid-cols-[10rem_minmax(0,1fr)_minmax(0,1.5fr)] lg:gap-x-10';
---

<section id="work" class="sheet border-t-[1.5px] border-ink py-section" aria-labelledby="work-title">
  <div class="mb-10 flex flex-wrap items-end justify-between gap-x-12 gap-y-4">
    <h2 id="work-title" class="text-headline">Index of work</h2>
    <p class="max-w-[30rem] text-body text-ink-soft">
      A selection. I did most of the consulting work together with the team at Netmaking.
    </p>
  </div>

  {
    featured.map((project) => (
      <article class="grid border-[1.5px] border-ink lg:grid-cols-[1.4fr_1fr]">
        <div class="p-panel">
          <h3 class="text-display">
            {project.href ? (
              <a href={project.href} target="_blank" rel="noopener noreferrer" class="no-underline hover:text-trail-ink">
                {project.title}
                <Arrow />
              </a>
            ) : (
              project.title
            )}
          </h3>
          <p class="mt-3 text-meta text-ink-soft">{project.kind}</p>
          {project.quote && (
            <p class="mt-4 text-title font-semibold text-contour" lang="nb">
              {project.quote}
            </p>
          )}
          <p class="mt-5 max-w-[52ch] text-lede text-pretty text-ink-soft">{project.summary}</p>
        </div>
        <div class="grid min-h-48 place-items-center border-t-[1.5px] border-ink bg-forest p-10 lg:border-t-0 lg:border-l-[1.5px]">
          {project.logo && (
            <img
              src={project.logo.src}
              width={project.logo.width}
              height={project.logo.height}
              alt={project.client}
              loading="lazy"
              decoding="async"
              class="h-auto w-[min(18rem,70%)] opacity-88 brightness-0"
            />
          )}
        </div>
      </article>
    ))
  }

  <div class="mt-12 border-[1.5px] border-ink">
    <div
      class:list={[
        'hidden border-b-[1.5px] border-ink bg-forest px-6 py-[0.6rem] text-label font-bold lg:grid',
        columns,
      ]}
      aria-hidden="true"
    >
      <span>Client</span>
      <span>Project</span>
      <span>Notes</span>
    </div>
    <ul class="grid">
      {
        rest.map((project) => (
          <li
            class:list={[
              'grid gap-3 px-[clamp(1.25rem,3vw,1.5rem)] py-[1.4rem] not-first:border-t not-first:border-rule tab:grid-cols-[9rem_1fr] tab:gap-x-8',
              columns,
            ]}
          >
            <div class="flex h-9 items-center">
              {project.logo ? (
                <img
                  src={project.logo.src}
                  width={project.logo.width}
                  height={project.logo.height}
                  alt={project.client}
                  loading="lazy"
                  decoding="async"
                  class="block h-auto max-h-8 w-auto max-w-[8.5rem] opacity-80 brightness-0"
                />
              ) : (
                <span class="text-title-sm font-extrabold uppercase opacity-80">{project.client}</span>
              )}
            </div>
            <div>
              <h3 class="text-title-sm text-balance">{project.title}</h3>
              <p class="mt-[0.15rem] text-meta text-contour">{project.kind}</p>
            </div>
            <p class="max-w-[60ch] text-body text-pretty text-ink-soft tab:col-start-2 lg:col-start-3">
              {project.summary}
            </p>
          </li>
        ))
      }
    </ul>
    <div class="grid gap-5 border-t-[1.5px] border-ink bg-paper-deep px-[clamp(1.25rem,3vw,1.5rem)] py-6 lg:grid-cols-[10rem_1fr] lg:gap-x-10">
      <h3 class="text-title-sm">What I do</h3>
      <dl class="grid gap-x-10 gap-y-5 tab:grid-cols-2 wide:grid-cols-4">
        {
          site.skills.map((skill) =>
            'lead' in skill && skill.lead ? (
              <div class="tab:col-span-full">
                <dt class="text-title font-extrabold">{skill.area}</dt>
                <dd class="mt-[0.3rem] max-w-[62ch] text-lede text-pretty text-ink">{skill.text}</dd>
              </div>
            ) : (
              <div>
                <dt class="font-bold">{skill.area}</dt>
                <dd class="mt-[0.3rem] max-w-[52ch] text-body text-pretty text-ink-soft">{skill.text}</dd>
              </div>
            ),
          )
        }
      </dl>
    </div>
  </div>
</section>
