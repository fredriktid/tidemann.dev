---
import { own, projects } from '@/content/projects';
import { site } from '@/content/site';
import Arrow from './Arrow.astro';

// Client / Project / Kind / disclosure mark, shared by the header and every row.
const columns = 'lg:grid-cols-[10rem_minmax(0,1.3fr)_minmax(0,1fr)_1.5rem] lg:gap-x-10';
---

<section id="work" class="sheet border-t-[1.5px] border-ink py-section" aria-labelledby="work-title">
  <div class="mb-10 flex flex-wrap items-end justify-between gap-x-12 gap-y-4">
    <h2 id="work-title" class="text-headline">Index of work</h2>
    <p class="max-w-[30rem] text-body text-ink-soft">
      Two things I built on my own time, then the client work. Most of the consulting I did together with the team at
      Netmaking.
    </p>
  </div>

  <div class="grid gap-6 lg:grid-cols-2 lg:gap-8">
    {
      own.map((project) => (
        <article class="grid grid-cols-[4.5rem_minmax(0,1fr)] border-[1.5px] border-ink tab:grid-cols-[7rem_minmax(0,1fr)]">
          <div class="grid place-items-center border-r-[1.5px] border-ink bg-forest p-3 tab:p-4" aria-hidden="true">
            {project.mark === 'hvisk' ? (
              <svg viewBox="0 0 32 32" class="size-10 tab:size-14">
                <path
                  d="M20 12l9-3.5M20 12l9 3.5M12 12l-9-3.5M12 12l-9 3.5"
                  class="fill-none stroke-ink stroke-[1.6]"
                  stroke-linecap="round"
                />
                <rect x="12" y="4" width="8" height="15" class="fill-ink" />
                <path d="M8 19h16l-2.5 9h-11z" class="fill-ink" />
              </svg>
            ) : (
              <svg viewBox="0 0 32 32" class="size-10 tab:size-14">
                <rect x="1" y="1" width="30" height="30" class="fill-none stroke-ink stroke-[1.6]" />
                <path d="M9 7h14v3.5h-9.5v4h8v3.5h-8V25H9z" class="fill-ink" />
              </svg>
            )}
          </div>
          <div class="p-[clamp(1.25rem,3vw,1.75rem)]">
            <h3 class="text-title">
              <a href={project.href} target="_blank" rel="noopener noreferrer" class="trail-link">
                {project.domain}
                <Arrow />
              </a>
            </h3>
            <p class="mt-3 max-w-[48ch] text-body text-pretty text-ink-soft">{project.summary}</p>
            <p class="mt-4 flex flex-wrap items-center gap-x-5 gap-y-1 text-meta">
              <span class="text-contour">{project.stack.join(' · ')}</span>
              <a href={project.source} target="_blank" rel="noopener noreferrer" class="inline-flex min-h-target items-center font-semibold">
                Source<Arrow />
              </a>
            </p>
          </div>
        </article>
      ))
    }
  </div>

  <div class="mt-10 border-[1.5px] border-ink">
    <div
      class:list={[
        'hidden border-b-[1.5px] border-ink bg-forest px-6 py-[0.6rem] text-label font-bold lg:grid',
        columns,
      ]}
      aria-hidden="true"
    >
      <span>Client</span>
      <span>Project</span>
      <span>Kind</span>
      <span></span>
    </div>
    <ul class="grid">
      {
        projects.map((project) => (
          <li class="not-first:border-t not-first:border-rule">
            <details class="group" open={project.current || undefined}>
              <summary
                class:list={[
                  'grid cursor-pointer list-none grid-cols-[minmax(0,1fr)_1.5rem] items-center gap-x-4 gap-y-1 px-[clamp(1.25rem,3vw,1.5rem)] py-[0.8rem] hover:bg-forest tab:grid-cols-[9rem_minmax(0,1fr)_1.5rem] tab:gap-x-8 [&::-webkit-details-marker]:hidden',
                  columns,
                ]}
              >
                <span class="col-start-1 flex h-8 items-center">
                  {project.logo ? (
                    <img
                      src={project.logo.src}
                      width={project.logo.width}
                      height={project.logo.height}
                      alt={project.client}
                      loading="lazy"
                      decoding="async"
                      class="block h-auto max-h-7 w-auto max-w-[8rem] opacity-80 brightness-0"
                    />
                  ) : (
                    <span class="text-body font-extrabold uppercase opacity-80">{project.client}</span>
                  )}
                </span>
                <h3 class="col-start-1 flex h-8 items-center text-body font-bold text-balance tab:col-start-2">
                  {project.titleLogo ? (
                    <img
                      src={project.titleLogo.src}
                      width={project.titleLogo.width}
                      height={project.titleLogo.height}
                      alt={project.title}
                      loading="lazy"
                      decoding="async"
                      class="block h-auto max-h-7 w-auto max-w-[8rem]"
                    />
                  ) : (
                    project.title
                  )}
                  {project.current && <span class="sr-only">(current)</span>}
                </h3>
                <span class="col-start-1 block text-meta text-contour tab:col-start-2 lg:col-start-3">{project.kind}</span>
                <svg
                  viewBox="0 0 10 10"
                  class="col-start-2 row-start-1 size-3 justify-self-end fill-none stroke-ink stroke-[1.5] transition-transform duration-200 ease-out-expo group-open:rotate-180 tab:col-start-3 lg:col-start-4"
                  aria-hidden="true"
                >
                  <path d="M1.5 3.5 5 7l3.5-3.5" />
                </svg>
              </summary>
              <div
                class:list={[
                  'grid gap-x-8 px-[clamp(1.25rem,3vw,1.5rem)] pb-[1.1rem] tab:grid-cols-[9rem_minmax(0,1fr)]',
                  columns,
                ]}
              >
                <div class="max-w-[62ch] tab:col-start-2 lg:col-span-2 lg:col-start-2">
                  {project.quote && (
                    <p class="mb-2 font-semibold text-contour" lang="nb">
                      {project.quote}
                    </p>
                  )}
                  <p class="text-body text-pretty text-ink-soft">
                    {project.href ? (
                      <>
                        {project.summary}{' '}
                        <a href={project.href} target="_blank" rel="noopener noreferrer" class="font-semibold whitespace-nowrap">
                          {project.client.toLowerCase() === project.title.toLowerCase() ? project.href.replace('https://', '') : 'Visit'}
                          <Arrow />
                        </a>
                      </>
                    ) : (
                      project.summary
                    )}
                  </p>
                </div>
              </div>
            </details>
          </li>
        ))
      }
    </ul>
    <div class="grid gap-5 border-t-[1.5px] border-ink bg-paper-deep px-[clamp(1.25rem,3vw,1.5rem)] py-6 lg:grid-cols-[10rem_1fr] lg:gap-x-10">
      <h3 class="text-title-sm">What I do</h3>
      <dl class="grid gap-x-10 gap-y-5 tab:grid-cols-2 wide:grid-cols-4">
        {
          site.skills.map((skill) =>
            'lead' in skill && skill.lead ? (
              <div class="tab:col-span-full">
                <dt class="text-title font-extrabold">{skill.area}</dt>
                <dd class="mt-[0.3rem] max-w-[62ch] text-lede text-pretty text-ink">{skill.text}</dd>
              </div>
            ) : (
              <div>
                <dt class="font-bold">{skill.area}</dt>
                <dd class="mt-[0.3rem] max-w-[52ch] text-body text-pretty text-ink-soft">{skill.text}</dd>
              </div>
            ),
          )
        }
      </dl>
    </div>
  </div>
</section>
