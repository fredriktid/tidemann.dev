---
import { projects } from '@/content/projects';
import { site } from '@/content/site';
import Arrow from './Arrow.astro';

const featured = projects.filter((p) => p.featured);
const rest = projects.filter((p) => !p.featured);
---

<section id="work" class="sheet work" aria-labelledby="work-title">
  <div class="work-head">
    <h2 id="work-title">Index of work</h2>
    <p class="work-note">A selection. I did most of the consulting work together with the team at Netmaking.</p>
  </div>

  {
    featured.map((project) => (
      <article class="feature">
        <div class="feature-text">
          <h3>
            {project.href ? (
              <a href={project.href} target="_blank" rel="noopener noreferrer">
                {project.title}
                <Arrow />
              </a>
            ) : (
              project.title
            )}
          </h3>
          <p class="feature-kind">{project.kind}</p>
          {project.quote && (
            <p class="feature-quote" lang="nb">
              {project.quote}
            </p>
          )}
          <p class="feature-summary">{project.summary}</p>
        </div>
        <div class="feature-plate">
          {project.logo && (
            <img
              src={project.logo.src}
              width={project.logo.width}
              height={project.logo.height}
              alt={project.client}
              loading="lazy"
              decoding="async"
            />
          )}
        </div>
      </article>
    ))
  }

  <div class="index-frame">
    <div class="index-head" aria-hidden="true">
      <span>Client</span>
      <span>Project</span>
      <span class="index-head-notes">Notes</span>
    </div>
    <ul class="index">
    {
      rest.map((project) => (
        <li>
          <div class="index-mark">
            {project.logo ? (
              <img
                src={project.logo.src}
                width={project.logo.width}
                height={project.logo.height}
                alt={project.client}
                loading="lazy"
                decoding="async"
              />
            ) : (
              <span class="wordmark">{project.client}</span>
            )}
          </div>
          <div>
            <h3>{project.title}</h3>
            <p class="index-kind">{project.kind}</p>
          </div>
          <p class="index-summary">{project.summary}</p>
        </li>
      ))
    }
    </ul>
    <div class="skills">
      <h3>What I do</h3>
      <dl>
        {
          site.skills.map((skill) => (
            <div class:list={[{ 'is-lead': 'lead' in skill && skill.lead }]}>
              <dt>{skill.area}</dt>
              <dd>{skill.text}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </div>

</section>

<style>
  .work {
    padding-block: clamp(4rem, 9vw, 7.5rem);
    border-top: 1.5px solid var(--color-ink);
  }

  .work-head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem 3rem;
    margin-bottom: 2.5rem;
  }

  h2 {
    font-size: clamp(2rem, 4.2vw, 3.25rem);
    font-weight: 800;
    line-height: 1.02;
    letter-spacing: -0.03em;
  }

  .work-note {
    max-width: 30rem;
    font-size: 0.95rem;
    color: var(--color-ink-soft);
    line-height: 1.5;
  }

  .feature {
    display: grid;
    border: 1.5px solid var(--color-ink);
  }

  .feature-text {
    padding: clamp(1.5rem, 4vw, 3rem);
  }

  .feature-kind {
    margin-top: 0.75rem;
    font-size: 0.95rem;
    color: var(--color-ink-soft);
  }

  .feature h3 {
    font-size: clamp(2.5rem, 7vw, 5rem);
    font-weight: 800;
    line-height: 0.95;
    letter-spacing: -0.035em;
  }

  .feature h3 a {
    text-decoration: none;
  }

  .feature h3 a:hover {
    color: var(--color-trail-ink);
  }

  .feature-quote {
    margin-top: 1rem;
    font-size: clamp(1.25rem, 2.4vw, 1.75rem);
    font-weight: 650;
    letter-spacing: -0.015em;
    color: var(--color-contour);
  }

  .feature-summary {
    margin-top: 1.25rem;
    max-width: 52ch;
    font-size: 1.05rem;
    line-height: 1.6;
    color: var(--color-ink-soft);
    text-wrap: pretty;
  }

  .feature-plate {
    display: grid;
    place-items: center;
    min-height: 12rem;
    padding: 2.5rem;
    border-top: 1.5px solid var(--color-ink);
    background: var(--color-forest);
  }

  .feature-plate img {
    width: min(18rem, 70%);
    height: auto;
    filter: brightness(0);
    opacity: 0.88;
  }

  .index-frame {
    margin-top: 3rem;
    border: 1.5px solid var(--color-ink);
  }

  .index-head {
    display: none;
    padding: 0.6rem 1.5rem;
    background: var(--color-forest);
    border-bottom: 1.5px solid var(--color-ink);
    font-size: 0.8rem;
    font-weight: 700;
  }

  .index {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .index li {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.75rem;
    padding: 1.4rem clamp(1.25rem, 3vw, 1.5rem);
  }

  .index li + li {
    border-top: 1px solid var(--color-rule);
  }

  .index-mark {
    display: flex;
    align-items: center;
    height: 2.25rem;
  }

  .index-mark img {
    display: block;
    width: auto;
    max-width: 8.5rem;
    max-height: 2rem;
    height: auto;
    filter: brightness(0);
    opacity: 0.8;
  }

  .wordmark {
    font-size: 1.05rem;
    font-weight: 800;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    opacity: 0.8;
  }

  .index h3 {
    font-size: 1.15rem;
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: -0.01em;
  }

  .index-kind {
    margin-top: 0.15rem;
    font-size: 0.85rem;
    color: var(--color-contour);
  }

  .index-summary {
    max-width: 60ch;
    font-size: 0.95rem;
    line-height: 1.55;
    color: var(--color-ink-soft);
    text-wrap: pretty;
  }

  .skills {
    display: grid;
    gap: 1.25rem;
    padding: 1.5rem clamp(1.25rem, 3vw, 1.5rem);
    border-top: 1.5px solid var(--color-ink);
    background: var(--color-paper-deep);
  }

  .skills h3 {
    font-size: 1.15rem;
    font-weight: 700;
  }

  .skills dl {
    display: grid;
    gap: 1.25rem 2.5rem;
    margin: 0;
  }

  .skills dt {
    font-weight: 700;
  }

  .skills dd {
    margin: 0.3rem 0 0;
    max-width: 52ch;
    font-size: 0.95rem;
    line-height: 1.55;
    color: var(--color-ink-soft);
    text-wrap: pretty;
  }

  .skills .is-lead dt {
    font-size: 1.35rem;
    font-weight: 800;
    letter-spacing: -0.015em;
  }

  .skills .is-lead dd {
    font-size: 1.05rem;
    color: var(--color-ink);
  }

  @media (min-width: 720px) {
    .index li {
      grid-template-columns: 9rem 1fr;
      column-gap: 2rem;
    }

    .index-summary {
      grid-column: 2;
    }
  }

  @media (min-width: 1024px) {
    .feature {
      grid-template-columns: 1.4fr 1fr;
    }

    .feature-plate {
      border-top: 0;
      border-left: 1.5px solid var(--color-ink);
    }

    .index-head,
    .index li {
      display: grid;
      grid-template-columns: 10rem minmax(0, 1fr) minmax(0, 1.5fr);
      column-gap: 2.5rem;
    }

    .index-summary {
      grid-column: 3;
    }

    .skills {
      grid-template-columns: 10rem 1fr;
      column-gap: 2.5rem;
    }

    .skills dl {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .skills .is-lead {
      grid-column: 1 / -1;
    }
  }
</style>
