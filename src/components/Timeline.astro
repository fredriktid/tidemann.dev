---
import { timeline } from '@/content/timeline';
import { site } from '@/content/site';
---

<section id="timeline" class="container-x py-28 sm:py-36">
  <div class="grid gap-12 lg:grid-cols-[1fr_2fr] lg:gap-20">
    <div class="lg:sticky lg:top-28 lg:self-start" data-reveal>
      <p class="eyebrow mb-4">01 — Timeline</p>
      <h2 class="text-balance text-4xl font-semibold tracking-[-0.03em] text-fg/80 sm:text-5xl">
        A rough <span class="em">timeline</span>
      </h2>
      <div class="mt-6 space-y-4 text-muted text-pretty leading-relaxed">
        {site.intro.map((p) => <p>{p}</p>)}
      </div>
    </div>

    <ol class="timeline relative">
      {
        timeline.map((entry, i) => (
          <li class="timeline-item relative grid gap-3 pb-14 pl-10 sm:grid-cols-[6rem_1fr] sm:gap-8 sm:pl-14" data-reveal style={`--reveal-delay: ${i * 60}ms`}>
            <span class="timeline-dot" class:list={[{ 'is-current': entry.current }]} aria-hidden="true" />
            <span class="timeline-year mono" aria-hidden="true">{entry.year}</span>
            <div class="sm:pt-1">
              <p class="mono text-xs text-muted">
                {entry.period}
                {entry.location && <span> · {entry.location}</span>}
              </p>
              <h3 class="mt-1 text-xl font-semibold tracking-tight sm:text-2xl">
                {entry.title}
                <span class="text-muted font-normal"> · {entry.org}</span>
              </h3>
              {entry.roles && (
                <ul class="mt-2 space-y-0.5">
                  {entry.roles.map((role) => (
                    <li class="mono text-xs text-muted">
                      {role.period} <span class="text-fg/70">{role.title}</span>
                    </li>
                  ))}
                </ul>
              )}
              <p class="mt-3 max-w-prose text-pretty leading-relaxed text-muted">{entry.summary}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .timeline::before {
    content: '';
    position: absolute;
    left: 0.45rem;
    top: 0.5rem;
    bottom: 0;
    width: 1px;
    background: linear-gradient(to bottom, var(--color-accent), var(--color-line) 30%, transparent);
  }

  .timeline-dot {
    position: absolute;
    left: 0;
    top: 0.5rem;
    width: 0.95rem;
    height: 0.95rem;
    border-radius: 999px;
    background: var(--color-bg);
    border: 1px solid var(--color-muted);
  }

  .timeline-dot.is-current {
    border-color: var(--color-accent);
    background: var(--color-accent);
    box-shadow: 0 0 0 6px color-mix(in oklab, var(--color-accent) 18%, transparent);
  }

  .timeline-year {
    font-size: clamp(1.6rem, 3vw, 2.4rem);
    line-height: 1;
    color: color-mix(in oklab, var(--color-fg) 28%, transparent);
    letter-spacing: -0.04em;
  }

  .timeline-item:hover .timeline-year {
    color: var(--color-accent);
    transition: color 0.3s ease;
  }
</style>
