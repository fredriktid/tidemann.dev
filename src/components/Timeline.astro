---
import { timeline } from '@/content/timeline';
import { site } from '@/content/site';
---

<section
  id="timeline"
  class="sheet grid gap-12 border-t-[1.5px] border-ink py-section lg:grid-cols-[minmax(0,1fr)_minmax(0,1.7fr)] lg:gap-20"
  aria-labelledby="route-title"
>
  <div class="lg:sticky lg:top-22 lg:self-start">
    <h2 id="route-title" class="text-headline text-balance">The route, 2001 to now</h2>
    <div class="mt-6 grid max-w-[38rem] gap-4 text-lede text-pretty text-ink-soft">
      {site.intro.map((p) => <p>{p}</p>)}
    </div>
  </div>

  <!-- The trail itself: DNT red, dashed, running the full length of the route. -->
  <ol
    class="relative before:absolute before:top-[0.9rem] before:bottom-2 before:left-[0.6rem] before:w-[3px] before:-translate-x-1/2 before:trail-dash"
  >
    {
      timeline.map((entry) => (
        <li class="relative grid gap-x-8 gap-y-1 pb-12 pl-11 last:pb-0 tab:grid-cols-[7rem_1fr] tab:pl-13">
          {entry.current ? (
            <span class="absolute top-[0.3rem] left-[0.6rem] size-[1.6rem] -translate-x-1/2 bg-paper" aria-hidden="true">
              <svg viewBox="0 0 20 20" class="block size-full fill-trail">
                <path d="M2 3h16v4.5h-5.5V18h-5V7.5H2Z" />
              </svg>
            </span>
          ) : (
            <span
              class="absolute top-[0.55rem] left-[0.6rem] size-[1.05rem] -translate-x-1/2 rounded-full border-3 border-trail bg-paper"
              aria-hidden="true"
            />
          )}
          <p class:list={['text-figure tabular-nums tab:pt-[0.1rem]', entry.current ? 'text-ink' : 'text-contour']}>{entry.year}</p>
          <div>
            <h3 class="text-title text-balance">
              {entry.title}{' '}
              <span class="font-book whitespace-nowrap text-ink-soft before:content-['·_']">{entry.org}</span>
            </h3>
            <p class="mt-[0.3rem] text-meta text-ink-soft">
              {entry.period}
              {entry.location && <span> · {entry.location}</span>}
              {entry.current && <span class="font-semibold text-trail-ink"> · You are here</span>}
            </p>
            {entry.roles && (
              <ul class="mt-3 grid gap-[0.15rem] border-t border-rule pt-[0.6rem] text-meta">
                {entry.roles.map((role) => (
                  <li class="grid grid-cols-[7.5rem_1fr]">
                    <span class="text-ink-soft tabular-nums">{role.period}</span>
                    <span>{role.title}</span>
                  </li>
                ))}
              </ul>
            )}
            <p class="mt-[0.85rem] max-w-[62ch] text-body text-pretty text-ink-soft">{entry.summary}</p>
          </div>
        </li>
      ))
    }
  </ol>
</section>
