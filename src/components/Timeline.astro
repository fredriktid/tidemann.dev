---
import { timeline } from '@/content/timeline';
import { site } from '@/content/site';
---

<section id="timeline" class="sheet route-section" aria-labelledby="route-title">
  <div class="route-intro">
    <h2 id="route-title">The route, 2001 to now</h2>
    <div class="route-copy">
      {site.intro.map((p) => <p>{p}</p>)}
    </div>
  </div>

  <ol class="trail">
    {
      timeline.map((entry) => (
        <li class:list={['waypoint', { 'is-current': entry.current }]}>
          <span class="marker" aria-hidden="true">
            {entry.current ? (
              <svg viewBox="0 0 20 20"><path d="M2 3h16v4.5h-5.5V18h-5V7.5H2Z" /></svg>
            ) : null}
          </span>
          <p class="year">{entry.year}</p>
          <div class="waypoint-body">
            <h3>
              {entry.title}
              <span class="org">{entry.org}</span>
            </h3>
            <p class="meta">
              {entry.period}
              {entry.location && <span> · {entry.location}</span>}
              {entry.current && <span class="here"> · You are here</span>}
            </p>
            {entry.roles && (
              <ul class="roles">
                {entry.roles.map((role) => (
                  <li>
                    <span class="roles-period">{role.period}</span> {role.title}
                  </li>
                ))}
              </ul>
            )}
            <p class="summary">{entry.summary}</p>
          </div>
        </li>
      ))
    }
  </ol>
</section>

<style>
  .route-section {
    display: grid;
    gap: 3rem;
    padding-block: clamp(4rem, 9vw, 7.5rem);
    border-top: 1.5px solid var(--color-ink);
  }

  h2 {
    font-size: clamp(2rem, 4.2vw, 3.25rem);
    font-weight: 800;
    line-height: 1.02;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }

  .route-copy {
    display: grid;
    gap: 1rem;
    margin-top: 1.5rem;
    max-width: 38rem;
    color: var(--color-ink-soft);
    font-size: 1.05rem;
    line-height: 1.6;
    text-wrap: pretty;
  }

  .trail {
    position: relative;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* The trail itself: DNT red, dashed, running the full length of the route. */
  .trail::before {
    content: '';
    position: absolute;
    left: 0.6rem;
    top: 0.9rem;
    bottom: 0.5rem;
    width: 3px;
    transform: translateX(-50%);
    background: repeating-linear-gradient(to bottom, var(--color-trail) 0 9px, transparent 9px 15px);
  }

  .waypoint {
    position: relative;
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.25rem 2rem;
    padding: 0 0 3rem 2.75rem;
  }

  .waypoint:last-child {
    padding-bottom: 0;
  }

  .marker {
    position: absolute;
    left: 0.6rem;
    top: 0.55rem;
    width: 1.05rem;
    height: 1.05rem;
    transform: translateX(-50%);
    border: 3px solid var(--color-trail);
    border-radius: 50%;
    background: var(--color-paper);
  }

  .is-current .marker {
    width: 1.6rem;
    height: 1.6rem;
    top: 0.3rem;
    border: 0;
    border-radius: 0;
    background: var(--color-paper);
  }

  .is-current .marker svg {
    display: block;
    width: 100%;
    height: 100%;
    fill: var(--color-trail);
  }

  .year {
    font-variant-numeric: tabular-nums;
    font-size: clamp(2rem, 3.4vw, 2.75rem);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--color-contour);
  }

  .is-current .year {
    color: var(--color-ink);
  }

  h3 {
    font-size: clamp(1.25rem, 2vw, 1.5rem);
    font-weight: 750;
    line-height: 1.2;
    letter-spacing: -0.015em;
  }

  .org {
    font-weight: 450;
    color: var(--color-ink-soft);
  }

  .org::before {
    content: ' · ';
  }

  .meta {
    margin-top: 0.3rem;
    font-size: 0.9rem;
    color: var(--color-ink-soft);
  }

  .here {
    color: var(--color-trail-ink);
    font-weight: 650;
  }

  .roles {
    display: grid;
    gap: 0.15rem;
    margin: 0.75rem 0 0;
    padding: 0.6rem 0 0;
    list-style: none;
    border-top: 1px solid var(--color-rule);
    font-size: 0.9rem;
  }

  .roles-period {
    display: inline-block;
    min-width: 7.5rem;
    color: var(--color-ink-soft);
  }

  .summary {
    margin-top: 0.85rem;
    max-width: 62ch;
    line-height: 1.6;
    color: var(--color-ink-soft);
    text-wrap: pretty;
  }

  @media (min-width: 720px) {
    .waypoint {
      grid-template-columns: 7rem 1fr;
      padding-left: 3.25rem;
    }

    .year {
      padding-top: 0.1rem;
    }
  }

  @media (min-width: 1024px) {
    .route-section {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.7fr);
      gap: 5rem;
    }

    .route-intro {
      position: sticky;
      top: 5.5rem;
      align-self: start;
    }
  }
</style>
