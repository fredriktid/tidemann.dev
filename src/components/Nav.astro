---
import { site } from '@/content/site';

const links = [
  { href: '#timeline', label: 'Timeline' },
  { href: '#work', label: 'Work' },
  { href: '#contact', label: 'Contact' },
];
---

<header class="sticky top-0 z-40 border-b-[1.5px] border-ink bg-paper">
  <div class="flex h-14 items-center justify-between gap-4 px-margin">
    <a
      href="#top"
      class="flex min-w-0 items-baseline gap-3 text-body no-underline"
      aria-label={`${site.domain}, back to top`}
    >
      <strong class="font-[750] tracking-[-0.01em] whitespace-nowrap">{site.domain}</strong>
      <span class="truncate text-ink-soft max-sm:hidden">{site.role}, {site.location.split(',')[0]}</span>
    </a>
    <nav aria-label="Primary">
      <ul class="flex gap-[clamp(1rem,2.5vw,2rem)]">
        {
          links.map((link) => (
            <li>
              <a
                href={link.href}
                class="inline-flex min-h-target items-center text-body font-medium no-underline hover:text-trail-ink"
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>
