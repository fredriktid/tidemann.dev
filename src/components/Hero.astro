---
import { site } from '@/content/site';
import SurveyMap from './SurveyMap.vue';
import Arrow from './Arrow.astro';

// Kilometre grid labels along the neat line, read as UTM zone 32 around Oslo.
const eastings = Array.from({ length: 14 }, (_, i) => 595 + i);
const northings = Array.from({ length: 8 }, (_, i) => 6646 - i);

const linkClass = 'inline-flex min-h-target items-center';
---

<section id="top" class="px-margin pb-10" aria-label="Introduction">
  <div class="relative [--gutter-l:2.75rem] [--gutter-t:1.75rem] max-sm:[--gutter-l:2.4rem] max-sm:[--gutter-t:1.4rem]">
    <div class="relative pt-(--gutter-t) pl-(--gutter-l)">
      <!-- Grid figures sit outside the neat line, aligned to the kilometre lines inside it. -->
      <div
        class="pointer-events-none absolute top-0 right-0 left-(--gutter-l) h-(--gutter-t) overflow-hidden text-map font-medium text-water tabular-nums"
        aria-hidden="true"
      >
        {
          eastings.map((e, i) => (
            <span
              class="absolute bottom-[0.45rem] left-[calc(var(--i)*var(--km)+1.5px)] -translate-x-1/2 first:translate-x-0"
              style={`--i: ${i}`}
            >
              {e}
            </span>
          ))
        }
      </div>
      <div
        class="pointer-events-none absolute top-(--gutter-t) bottom-0 left-0 w-(--gutter-l) overflow-hidden text-map font-medium text-water tabular-nums"
        aria-hidden="true"
      >
        {
          northings.map((n, i) => (
            <span
              class="absolute top-[calc(var(--i)*var(--km)+1.5px)] right-[0.45rem] -translate-y-1/2 first:translate-y-0"
              style={`--i: ${i}`}
            >
              {n}
            </span>
          ))
        }
      </div>

      <div
        class="relative h-[clamp(26rem,118vw,74svh)] overflow-hidden border-[1.5px] border-ink bg-paper wide:h-[clamp(36rem,calc(100svh-7.75rem),62rem)]"
      >
        <SurveyMap client:load src="/avatar.png" fallback="/avatar-32.png" alt={`Pixel portrait of ${site.name}`} />

        <svg
          class="pointer-events-none absolute inset-x-0 bottom-0 size-full overflow-visible"
          viewBox="0 0 1000 100"
          preserveAspectRatio="none"
          aria-hidden="true"
        >
          <path
            d="M0 88 C80 84 140 95 230 92 S380 85 470 92 S640 97 712 90"
            vector-effect="non-scaling-stroke"
            class="fill-none stroke-trail stroke-3 [stroke-dasharray:9_6]"></path>
        </svg>
        <a
          href="#timeline"
          class="group absolute top-[90%] left-[71.2%] flex min-h-target -translate-x-[0.6rem] -translate-y-1/2 items-center gap-2 pr-3 text-meta font-semibold text-ink no-underline max-sm:right-2 max-sm:left-auto max-sm:translate-x-0"
        >
          <svg viewBox="0 0 20 20" class="size-5 flex-none fill-trail" aria-hidden="true"
            ><path d="M2 3h16v4.5h-5.5V18h-5V7.5H2Z"></path></svg
          >
          <span class="border border-ink bg-paper px-[0.45rem] py-[0.2rem] transition-colors duration-200 group-hover:bg-forest"
            >The route, 2001 to now</span
          >
        </a>
      </div>
    </div>

    <!-- Legend: a margin panel under the map on small sheets, an inset on wide ones. -->
    <aside
      class="mt-5 border-[1.5px] border-ink bg-paper p-6 max-sm:p-5 wide:absolute wide:top-[calc(var(--gutter-t)+1.25rem)] wide:right-5 wide:z-2 wide:m-0 wide:w-[23rem]"
      aria-labelledby="legend-title"
    >
      <h1 id="legend-title" class="text-name text-balance">
        {site.name}
      </h1>
      <p class="mt-[0.6rem] text-title-sm">{site.headline}</p>
      <p class="mt-3 max-w-[34ch] text-body text-pretty text-ink-soft">{site.lede}</p>

      <dl class="mt-5 grid gap-[0.6rem] border-y border-rule py-4 *:grid *:grid-cols-[2.5rem_1fr] *:items-center *:gap-3">
        <div>
          <dt>
            <svg viewBox="0 0 40 14" class="block h-[0.9rem] w-10 overflow-visible" aria-hidden="true"
              ><path d="M1 10C9 2 16 2 22 7s12 5 17-1" class="fill-none stroke-contour stroke-[1.4]"></path></svg
            >
          </dt>
          <dd class="text-label text-ink-soft">Contours: lines traced from the light and dark in my photo, live in WebAssembly</dd>
        </div>
        <div>
          <dt>
            <svg viewBox="0 0 40 14" class="block h-[0.9rem] w-10 overflow-visible" aria-hidden="true"
              ><rect x="2" y="1" width="11" height="11" class="fill-[#b7c79c]"></rect><rect
                x="15"
                y="1"
                width="11"
                height="11"
                class="fill-[#e2d7bd]"></rect><rect x="28" y="1" width="5" height="5" class="fill-[#b7c79c]"></rect><rect
                x="34"
                y="1"
                width="5"
                height="5"
                class="fill-[#e2d7bd]"></rect><rect x="28" y="7" width="5" height="5" class="fill-[#e2d7bd]"></rect><rect
                x="34"
                y="7"
                width="5"
                height="5"
                class="fill-[#b7c79c]"></rect></svg
            >
          </dt>
          <dd class="text-label text-ink-soft">Tiles: my photo in blocks. Move the pointer over it for more detail</dd>
        </div>
        <div>
          <dt>
            <svg viewBox="0 0 40 14" class="block h-[0.9rem] w-10 overflow-visible" aria-hidden="true"
              ><path d="M1 8h38" class="fill-none stroke-trail stroke-3 [stroke-dasharray:6_4]"></path></svg
            >
          </dt>
          <dd class="text-label text-ink-soft">Route: where I have worked. Scroll down to follow it</dd>
        </div>
      </dl>

      <ul class="mt-4 flex flex-wrap gap-x-6 font-semibold">
        <li class="basis-full"><a href={`mailto:${site.email}`} class:list={['trail-link', linkClass]}>{site.email}</a></li>
        <li><a href={site.linkedin} target="_blank" rel="noopener noreferrer me" class={linkClass}>LinkedIn<Arrow /></a></li>
        <li><a href={site.github} target="_blank" rel="noopener noreferrer me" class={linkClass}>GitHub<Arrow /></a></li>
        <li><a href={site.gitlab} target="_blank" rel="noopener noreferrer me" class={linkClass}>GitLab<Arrow /></a></li>
      </ul>
      <p class="mt-1 text-label text-ink-soft">{site.location} · {site.tagline}</p>
    </aside>
  </div>
</section>
