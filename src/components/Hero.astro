---
import { site } from '@/content/site';
import ParticleField from './ParticleField.vue';
import PixelPortrait from './PixelPortrait.vue';
---

<section id="top" class="relative isolate flex min-h-dvh flex-col justify-center overflow-hidden pt-24 pb-20">
  <ParticleField client:load />
  <div class="hero-vignette" aria-hidden="true"></div>

  <div class="container-x relative grid items-center gap-12 lg:grid-cols-[1.35fr_1fr] lg:gap-16">
    <div>
      <p class="eyebrow mb-6 flex items-center gap-3">
        <span class="inline-block size-2 rounded-full bg-accent"></span>
        {site.location} · {site.tagline}
      </p>
      <h1 class="hero-title text-balance font-semibold tracking-[-0.04em] text-fg/80">
        Hi, I'm <span class="whitespace-nowrap">Fredrik.</span>
        <br />
        <span class="em">Tech lead</span> who still
        <br class="hidden sm:block" />
        <span class="em">ships</span> <span class="em">code.</span>
      </h1>
      <p class="mt-8 max-w-xl text-pretty text-lg leading-relaxed text-muted sm:text-xl">
        Twenty-plus years building fast, resilient things for the web. Currently leading ed-tech development at <span
          class="text-fg">Aschehoug</span>.
      </p>
      <div class="mt-10 flex flex-wrap items-center gap-4">
        <a
          href={site.linkedin}
          target="_blank"
          rel="noopener noreferrer me"
          class="link-draw text-sm text-muted hover:text-fg"
        >
          LinkedIn ↗
        </a>
        <a href={site.github} target="_blank" rel="noopener noreferrer me" class="link-draw text-sm text-muted hover:text-fg">
          GitHub ↗
        </a>
      </div>
    </div>

    <div class="relative mx-auto w-full max-w-[20rem] sm:max-w-[24rem] lg:max-w-none">
      <div class="portrait-wrap">
        <PixelPortrait client:load src="/avatar.png" fallback="/avatar-32.png" alt={`Pixel portrait of ${site.name}`} />
      </div>
      <span class="sticker mono float" aria-hidden="true">gravel · snow · web</span>
    </div>
  </div>
</section>

<style>
  .hero-title {
    font-size: clamp(2.6rem, 7.2vw, 6.2rem);
    line-height: 0.98;
  }

  .hero-vignette {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background: linear-gradient(to bottom, transparent 80%, var(--color-bg));
  }

  .portrait-wrap {
    transform: rotate(-2deg);
    transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .portrait-wrap:hover {
    transform: rotate(0deg) scale(1.02);
  }

  .sticker {
    position: absolute;
    right: -0.5rem;
    top: -1rem;
    padding: 0.45rem 0.8rem;
    border-radius: 999px;
    background: var(--color-accent);
    color: var(--color-bg);
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
</style>
