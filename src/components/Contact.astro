---
import { site } from '@/content/site';
import Arrow from './Arrow.astro';

const edition = new Date().getFullYear();
const imprint = [
  { term: 'Edition', value: String(edition) },
  { term: 'Grid', value: '1 km squares, labelled as UTM zone 32 around Oslo' },
  { term: 'Terrain', value: 'Made in WebAssembly on your device. Not for navigation.' },
];
---

<section id="contact" class="sheet" aria-labelledby="contact-title">
  <div
    class="mb-[clamp(2rem,5vw,3rem)] grid gap-x-20 gap-y-6 border-[1.5px] border-ink p-panel lg:grid-cols-[minmax(0,1fr)_minmax(0,1.7fr)]"
  >
    <h2 id="contact-title" class="text-headline">Contact</h2>
    <div>
      <p class="max-w-[58ch] text-lede text-pretty text-ink-soft">{site.contact}</p>
      <p class="mt-4 max-w-[58ch] text-lede text-pretty text-ink-soft">{site.offDuty}</p>
      <a
        href={`mailto:${site.email}`}
        class="mt-8 inline-block text-email wrap-anywhere decoration-trail decoration-3 underline-offset-[0.18em] hover:text-trail-ink"
      >
        {site.email}
      </a>
      <ul class="mt-5 flex gap-6 font-semibold">
        <li>
          <a href={site.linkedin} target="_blank" rel="noopener noreferrer me" class="inline-flex min-h-target items-center"
            >LinkedIn<Arrow /></a
          >
        </li>
        <li>
          <a href={site.github} target="_blank" rel="noopener noreferrer me" class="inline-flex min-h-target items-center"
            >GitHub<Arrow /></a
          >
        </li>
        <li>
          <a href={site.gitlab} target="_blank" rel="noopener noreferrer me" class="inline-flex min-h-target items-center"
            >GitLab<Arrow /></a
          >
        </li>
      </ul>
    </div>

    <dl
      class="mt-4 grid gap-x-8 gap-y-2 border-t border-rule pt-5 text-label text-ink-soft lg:col-span-full lg:grid-cols-[repeat(3,auto)] lg:justify-start"
    >
      {
        imprint.map((item) => (
          <div class="flex gap-[0.6rem]">
            <dt class="font-bold text-ink">{item.term}</dt>
            <dd>{item.value}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>
